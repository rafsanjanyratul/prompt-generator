PORT=5000
FRONTEND_URL=http://localhost:5173
APP_BASE_URL=http://localhost:5173
MONGODB_URI=mongodb+srv://username@cluster0.xxxxx.mongodb.net/promptmuse?retryWrites=true&w=majority
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
EMAIL_PROVIDER=resend
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=noreply@prompttouchai.com

# Gmail SMTP settings are only required when EMAIL_PROVIDER=gmail.
# When using the Resend provider, the SMTP_HOST/SMTP_USER/SMTP_PASS/SMTP_FROM
# variables are not required and can be left unset.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your_app_password
# SMTP_FROM=your-email@gmail.com
JWT_SECRET=your_32_character_or_longer_secret
JWT_EXPIRES_IN=7d
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
OPENAI_API_KEY=your_actual_secret_api_key

SSLCOMMERZ_STORE_ID=your_actual_store_id
SSLCOMMERZ_STORE_PASSWORD=your_actual_store_password
SSLCOMMERZ_IS_SANDBOX=true